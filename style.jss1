* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    font-family: Arial, sans-serif;
}

body {
    background: linear-gradient(135deg, #667eea, #764ba2);
    min-height: 100vh;
    padding: 30px;
}

.container {
    max-width: 1100px;
    margin: auto;
    background: white;
    padding: 30px;
    border-radius: 15px;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.2);
}

h1 {
    text-align: center;
    color: #333;
    margin-bottom: 8px;
}

.subtitle {
    text-align: center;
    color: #777;
    margin-bottom: 30px;
}

.form-box {
    display: flex;
    gap: 12px;
    margin-bottom: 30px;
    flex-wrap: wrap;
}

input,
select {
    flex: 1;
    min-width: 180px;
    padding: 13px;
    border: 1px solid #ccc;
    border-radius: 8px;
    font-size: 15px;
}

button {
    background: #4f46e5;
    color: white;
    border: none;
    padding: 13px 20px;
    border-radius: 8px;
    cursor: pointer;
    font-size: 15px;
}

button:hover {
    background: #3730a3;
}

.summary {
    display: flex;
    gap: 20px;
    margin-bottom: 30px;
}

.card {
    flex: 1;
    background: #eef2ff;
    padding: 20px;
    text-align: center;
    border-radius: 10px;
}

.card h3 {
    color: #444;
    margin-bottom: 10px;
}

.card p {
    font-size: 30px;
    font-weight: bold;
    color: #4f46e5;
}

.card.present {
    background: #dcfce7;
}

.card.present p {
    color: #16a34a;
}

.card.absent {
    background: #fee2e2;
}

.card.absent p {
    color: #dc2626;
}

.table-container {
    overflow-x: auto;
}

table {
    width: 100%;
    border-collapse: collapse;
}

th,
td {
    padding: 14px;
    text-align: center;
    border-bottom: 1px solid #ddd;
}

th {
    background: #4f46e5;
    color: white;
}

.present-status {
    color: #16a34a;
    font-weight: bold;
}

.absent-status {
    color: #dc2626;
    font-weight: bold;
}

.delete-btn {
    background: #dc2626;
    padding: 8px 12px;
}

.delete-btn:hover {
    background: #991b1b;
}

.clear-btn {
    display: block;
    margin: 25px auto 0;
    background: #dc2626;
}

@media (max-width: 700px) {
    body {
        padding: 15px;
    }

    .container {
        padding: 20px;
    }

    .summary {
        flex-direction: column;
    }

    .form-box {
        flex-direction: column;
    }

    input,
    select,
    .form-box button {
        width: 100%;
    }
}
