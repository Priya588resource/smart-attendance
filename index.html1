<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Smart Attendance System</title>
    <link rel="stylesheet" href="style.css">
</head>
<body>

    <div class="container">
        <h1>Smart Attendance System</h1>
        <p class="subtitle">Student Attendance Management</p>

        <div class="form-box">
            <input type="text" id="studentName" placeholder="Enter student name">
            <input type="text" id="studentRoll" placeholder="Enter roll number">

            <select id="attendanceStatus">
                <option value="Present">Present</option>
                <option value="Absent">Absent</option>
            </select>

            <button onclick="addAttendance()">Mark Attendance</button>
        </div>

        <div class="summary">
            <div class="card">
                <h3>Total Students</h3>
                <p id="total">0</p>
            </div>

            <div class="card present">
                <h3>Present</h3>
                <p id="present">0</p>
            </div>

            <div class="card absent">
                <h3>Absent</h3>
                <p id="absent">0</p>
            </div>
        </div>

        <div class="table-container">
            <table>
                <thead>
                    <tr>
                        <th>S.No</th>
                        <th>Student Name</th>
                        <th>Roll Number</th>
                        <th>Status</th>
                        <th>Action</th>
                    </tr>
                </thead>

                <tbody id="attendanceTable">
                </tbody>
            </table>
        </div>

        <button class="clear-btn" onclick="clearAttendance()">
            Clear All
        </button>
    </div>

    <script src="script.js"></script>
</body>
</html>
